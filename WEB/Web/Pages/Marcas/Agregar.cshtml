@page
@model Web.Pages.Marcas.AgregarModel
@{
}


<h1>Agregar Marcas</h1>

<div class="container">
    <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 mx-auto">
        <form method="post">
            <div class="form-group">
                <label class="control-label">Nombre de la Marca</label>
                <input class="form-control" type="text" asp-for=marca.Nombre>
                <span class="text-danger" asp-validation-for="marca.Nombre"></span>
            </div>
            <div class="form-group">
                <a class="btn btn-primary" asp-page="./IndexMarcas"><i class="bi bi-arrow-left"></i></a>
                <button type="submit" class="btn btn-success text-white"><i class="bi bi-plus-circle"></i></button>
            </div>
        </form>
    </div>
</div>